rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own root profile document (/users/{uid})
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Allow users to read/write all subcollections under their user directory
    // e.g. /users/{uid}/progress/{qId}, /users/{uid}/bookmarks/{qId}, etc.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
