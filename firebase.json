{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "README.md",
      "firestore.rules",
      "node_modules/**",
      "backend/**",
      "*.json.key",
      "*firebase-adminsdk*.json",
      "*service-account*.json",
      ".env",
      "algoforge_resume_interview.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
