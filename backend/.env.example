# ─────────────────────────────────────────────────────────────────────────────
# AlgoQuest Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Judge0 CE ─────────────────────────────────────────────────────────────────
# Get a key at https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_key_here

# Set to false to use the public ce.judge0.com endpoint (no key needed, but rate-limited)
JUDGE0_USE_RAPIDAPI=true

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Download your service account JSON from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# Set this to the ABSOLUTE path of that file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Your Firebase project ID (visible in the Firebase console)
FIREBASE_PROJECT_ID=algoquest-9aab0

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Comma-separated list of allowed frontend origins for CORS.
# Add your Firebase Hosting URL when deploying.
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5501,http://localhost:8080,http://127.0.0.1:5500,https://algoquest-9aab0.web.app,https://algoquest-9aab0.firebaseapp.com

# ── Execution limits ──────────────────────────────────────────────────────────
# Maximum polling attempts before declaring timeout (each attempt = 2 seconds)
JUDGE0_MAX_POLL_ATTEMPTS=20
JUDGE0_POLL_INTERVAL_SECONDS=2.0
