# ─────────────────────────────────────────────────────────────────────────────
# AlgoQuest — Docker Compose Local Development Environment Variables
# Copy this file to .env before running `docker compose up -d`.
# NEVER commit real production secrets or credentials to Git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Configuration (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=algoquest_dev
POSTGRES_PORT=5432

# Backend Configuration (api service)
APP_ENV=development
DATABASE_BACKEND=supabase
# SUPABASE_DB_URL points to the internal Docker network postgres container:
SUPABASE_DB_URL=postgresql://postgres:postgres@db:5432/algoquest_dev
QUEUE_ENABLE_PG_BACKEND=true
ALLOW_SAMPLE_ONLY_GRADING=true
SUBMISSION_WORKERS=2
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text
ALLOWED_ORIGINS_STR=http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500,https://algoquest-9aab0.web.app

# Firebase Authentication (Optional in dev if testing unauthenticated routes)
# For full authenticated testing, supply either a JSON string or project ID:
FIREBASE_PROJECT_ID=algoquest-9aab0
FIREBASE_SERVICE_ACCOUNT_JSON=

# Judge0 CE Code Execution (Optional in dev; sample tests run if API key omitted)
# Get a key at https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=
JUDGE0_USE_RAPIDAPI=true
